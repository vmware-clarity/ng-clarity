{
  "extends": "../projects/angular/tsconfig.lib.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "helpers/*": ["./helpers/*"],
      "stories/*": ["./stories/*"],
      "@clr/angular": ["./../projects/angular/index.ts"],
      "@clr/angular/*": ["./../projects/angular/*"],
      "@clr/addons": ["./../projects/addons/index.ts"],
      "@clr/addons/*": ["./../projects/addons/*"],
      "@clr/examples": ["./../projects/examples/index.ts"],
      "@clr/examples/*": ["./../projects/examples/*"],
      "@storybook-helpers/*": ["./helpers/*"]
    },
    "types": ["node"]
  },
  "exclude": ["../src/test.ts", "../src/**/*.spec.ts", "../projects/**/*.spec.ts"],
  "include": ["./stories/**/*.ts", "./helpers/**/*.ts"],
  "files": ["./typings.d.ts"]
}
