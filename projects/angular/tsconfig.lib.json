{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "noImplicitOverride": true,
    "types": []
  },
  "angularCompilerOptions": {
    "enableResourceInlining": true,
    "skipTemplateCodegen": true,
    "strictMetadataEmit": true
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.mock.ts",
    "**/*.stories.ts",
    "schematics/**",
    "utils/testing/**",
    "forms/tests/**",
    "data/datagrid/helpers.ts"
  ]
}
